# VidyaSetu Environment Configuration

# Server Configuration
PORT=5000
NODE_ENV=development

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# Active Database Environment Selection: 'office' | 'local' | 'server' | 'staging' | 'test'
DB_TARGET=office

# ------------------------------------------------------------------------------
# 1. Office Database Configuration (Office MySQL / XAMPP / Local without password)
# ------------------------------------------------------------------------------
DB_OFFICE_HOST=localhost
DB_OFFICE_PORT=3306
DB_OFFICE_USER=root
DB_OFFICE_PASSWORD=
DB_OFFICE_NAME=vidyasetu
DB_OFFICE_SSL=false

# ------------------------------------------------------------------------------
# 2. Local Database Configuration (Personal MySQL / Laragon / Docker with password)
# ------------------------------------------------------------------------------
DB_LOCAL_HOST=localhost
DB_LOCAL_PORT=3306
DB_LOCAL_USER=root
DB_LOCAL_PASSWORD=vedbhumi
DB_LOCAL_NAME=vidyasetu
DB_LOCAL_SSL=false

# ------------------------------------------------------------------------------
# 3. Server / Cloud / Production Database Configuration (AWS RDS, GCP, Aiven, VPS, etc.)
# ------------------------------------------------------------------------------
DB_SERVER_HOST=your-remote-db-host.com
DB_SERVER_PORT=3306
DB_SERVER_USER=server_db_user
DB_SERVER_PASSWORD=your_server_secure_password
DB_SERVER_NAME=vidyasetu
DB_SERVER_SSL=false

# ------------------------------------------------------------------------------
# 4. Staging Database Configuration (Optional)
# ------------------------------------------------------------------------------
DB_STAGING_HOST=your-staging-db-host.com
DB_STAGING_PORT=3306
DB_STAGING_USER=staging_user
DB_STAGING_PASSWORD=your_staging_password
DB_STAGING_NAME=vidyasetu_staging
DB_STAGING_SSL=false

# ------------------------------------------------------------------------------
# 5. Fallback / Direct Database Overrides (legacy compatibility)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vidyasetu

# ==============================================================================
# REDIS CONFIGURATION (Optional for basic development)
# ==============================================================================
REDIS_URL=redis://localhost:6379

# ==============================================================================
# SMTP EMAIL CONFIGURATION
# ==============================================================================
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
FRONTEND_URL=

# ==============================================================================
# JWT AUTHENTICATION
# ==============================================================================
JWT_SECRET=vidyasetu_jwt_super_secret_access_key_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=vidyasetu_jwt_super_secret_refresh_key_2026
JWT_REFRESH_EXPIRES_IN=7d

# ==============================================================================
# MASTER SAAS TENANT
# ==============================================================================
MASTER_TENANT_ID=vidyasetu-master-hq-id
