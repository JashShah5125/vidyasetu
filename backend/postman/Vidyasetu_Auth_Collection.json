{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7g8h-9i0j",
		"name": "VidyaSetu Auth API",
		"description": "Comprehensive test suite for VidyaSetu Authentication",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Login - Valid SaaS Admin",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"const response = pm.response.json();",
							"if(response.data && response.data.token) {",
							"    pm.environment.set(\"auth_token\", response.data.token);",
							"}",
							"if(response.data && response.data.refreshToken) {",
							"    pm.environment.set(\"refresh_token\", response.data.refreshToken);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [ { "key": "Content-Type", "value": "application/json" } ],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"email\": \"admin@vidyasetu.com\",\r\n    \"password\": \"password123\"\r\n}"
				},
				"url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
			}
		},
		{
			"name": "2. Refresh Token",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
							"const response = pm.response.json();",
							"if(response.data && response.data.token) {",
							"    pm.environment.set(\"auth_token\", response.data.token);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [ { "key": "Content-Type", "value": "application/json" } ],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"refreshToken\": \"{{refresh_token}}\"\r\n}"
				},
				"url": { "raw": "{{base_url}}/api/auth/refresh", "host": ["{{base_url}}"], "path": ["api", "auth", "refresh"] }
			}
		},
		{
			"name": "3. Logout",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [ { "key": "Content-Type", "value": "application/json" } ],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"refreshToken\": \"{{refresh_token}}\"\r\n}"
				},
				"url": { "raw": "{{base_url}}/api/auth/logout", "host": ["{{base_url}}"], "path": ["api", "auth", "logout"] }
			}
		}
	]
}
