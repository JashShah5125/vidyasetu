		{
			"name": "Module 0: Parent Auth & Session",
			"item": [
				{
					"name": "1. Parent Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const jsonData = pm.response.json();",
									"pm.test(\"Login successful for Parent\", function () {",
									"    pm.expect(jsonData.success).to.eql(true);",
									"    pm.expect(jsonData.data.userType).to.eql('parent');",
									"    pm.expect(jsonData.data).to.have.property('tokens');",
									"    pm.expect(jsonData.data.tokens).to.have.property('accessToken');",
									"});",
									"",
									"if (jsonData.data && jsonData.data.tokens) {",
									"    pm.collectionVariables.set(\"parentAccessToken\", jsonData.data.tokens.accessToken);",
									"    pm.collectionVariables.set(\"parentRefreshToken\", jsonData.data.tokens.refreshToken);",
									"    if (jsonData.data.parent && jsonData.data.parent.children && jsonData.data.parent.children.length > 0) {",
									"        pm.collectionVariables.set(\"childStudentId\", String(jsonData.data.parent.children[0].studentId));",
									"    }",
									"    console.log(\"Saved parentAccessToken, parentRefreshToken, and childStudentId\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"identifier\": \"{{parentIdentifier}}\",\n  \"password\": \"{{parentPassword}}\",\n  \"deviceMeta\": {\n    \"deviceIdentifier\": \"parent-galaxy-s24-mock-001\",\n    \"deviceName\": \"Galaxy S24 Ultra\",\n    \"osType\": \"Android\",\n    \"osVersion\": \"14\",\n    \"appVersion\": \"1.0.0\",\n    \"fcmToken\": \"mock_parent_fcm_token_9876543210\"\n  }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/app/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"app",
								"auth",
								"login"
							]
						}
					},
					"response": []
				},
