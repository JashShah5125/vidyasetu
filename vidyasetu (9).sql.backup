INSERT INTO `saas_lead_followups` (`id`, `lead_id`, `followup_mode`, `outcome`, `notes`, `next_followup_at`, `created_at`, `created_by`) VALUES
(5, 15, 'Call', 'Initial 30-minute intro call with the vice principal. Explained the platform and how it helps with batch scheduling and fee tracking.', 'VP seemed interested; will share a recorded demo.', '2026-09-18 00:00:00', '2026-09-17 14:34:09', 1),
(6, 15, 'Video Demo', 'Full product walkthrough done over video call; both owners were present and asked detailed questions about the timetable drag-drop.', 'Started a 14-day free trial. Very positive response.', '2026-09-22 00:00:00', '2026-09-17 14:34:09', 1),
(7, 16, 'Call', 'Spoke with the admin head; they are waiting for management approval before scheduling a live demo.', 'Follow up only after 18th.', '2026-09-19 00:00:00', '2026-09-17 14:34:09', 1),
(8, 17, 'Meeting', 'On-site meeting completed. The owner liked the attendance module and asked for a custom pricing quote for 4 classrooms.', 'Send proposal with Phase-1 + Phase-2 pricing.', '2026-09-21 00:00:00', '2026-09-17 14:34:09', 1),
(9, 18, 'WhatsApp', 'Shared the product brochure and a short demo clip on WhatsApp. Coordinator will review and revert.', NULL, '2026-09-18 00:00:00', '2026-09-17 14:34:09', 1),
(10, 19, 'Call', 'First outreach call. They are planning to digitize operations next month and requested a demo.', 'New lead - book demo slot.', '2026-09-23 00:00:00', '2026-09-17 14:34:09', 1),
(11, 20, 'Email', 'Sent the pricing comparison email after two calls. No response received; decided to close the lead.', 'Could not proceed.', NULL, '2026-09-17 14:34:09', 1),
(12, 15, 'call', 'test', NULL, '2026-09-23 00:00:00', '2026-09-22 13:10:57', 1),
(13, 15, 'call', 'test2', NULL, '2026-09-30 00:00:00', '2026-09-22 13:15:14', 1),
(14, 20, 'call', 'test', NULL, '2026-09-22 00:00:00', '2026-09-22 13:16:06', 1),
(15, 22, 'call', 'qaewsertdrcytvuyb', NULL, '2026-09-28 00:00:00', '2026-09-28 12:02:47', 1),
(16, 22, 'Phone Call', 'test', NULL, NULL, '2026-09-30 14:09:02', 1),
(17, 17, 'Demo', 'test', NULL, '2026-09-30 00:00:00', '2026-09-30 14:13:31', 1),
(18, 22, 'Phone Call', 'test2', NULL, NULL, '2026-09-30 17:29:24', 1),
(19, 22, 'Status Change', 'Stage changed from \"Plan Assigned\" to \"Hot Lead (Interested)\": test3', 'test3', '2026-09-27 00:00:00', '2026-10-01 11:27:58', 1);

