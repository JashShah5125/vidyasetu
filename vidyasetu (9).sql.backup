INSERT INTO `support_replies` (`id`, `ticket_id`, `sender_id`, `sender_role`, `sender_type`, `is_from_staff`, `message`, `created_at`, `attachment_url`, `attachment_name`) VALUES
(1, 1, 2, 'tenant', 'INSTITUTE_ADMIN', 0, 'The annual renewal invoice for the Pro plan shows a monthly billing cycle. Our account team expects the annual amount with the 10% enterprise discount applied. Please verify.', '2026-08-24 10:15:00', NULL, NULL),
(2, 1, 1, 'staff', 'SAAS_ADMIN', 1, 'Hi there - this looks like a stale plan reference on the invoice. I have corrected the cycle to annual and applied the 10% discount. A corrected invoice (INV-2026-0001) is in the payments section.', '2026-08-24 12:45:00', NULL, NULL),
(3, 1, 2, 'tenant', 'INSTITUTE_ADMIN', 0, 'Confirmed on our end, the corrected invoice looks right now. Thanks for the quick turnaround.', '2026-08-25 09:00:00', NULL, NULL),
(4, 1, 1, 'staff', 'SAAS_ADMIN', 1, 'Great to hear. Keeping this ticket in progress while we push the same fix to your billing report email templates.', '2026-08-25 10:30:00', NULL, NULL),
(5, 2, 103, 'tenant', 'INSTITUTE_ADMIN', 0, 'Since the maintenance window last Saturday, all admin staff are getting \"Invalid session\" on the mobile app even after re-logging in. Works fine on web.', '2026-08-26 09:40:00', NULL, NULL),
(6, 3, NULL, 'tenant', 'INSTITUTE_ADMIN', 0, 'We need a per-student fee split for our new repeaters batch: 60% payable at admission and 40% before the second semester. Can the fee module support a custom schedule?', '2026-08-18 14:05:00', NULL, NULL),
(7, 3, 1, 'staff', 'SAAS_ADMIN', 1, 'Yes - the fee module supports custom installment schedules per batch. We have enabled the \"custom installments\" toggle for your tenant and attached a 2-installment split (60/40) template. You can edit it under Batch > Fee Plan.', '2026-08-19 11:20:00', NULL, NULL),
(8, 3, NULL, 'tenant', 'INSTITUTE_ADMIN', 0, 'Works as expected, installment alert SMS go out correctly. Resolving from our side.', '2026-08-20 15:10:00', NULL, NULL),
(9, 4, NULL, 'tenant', 'INSTITUTE_ADMIN', 0, 'Every bulk upload returns \"row 12 malformed\" even though the file matches the template. We suspect phone number formatting is the issue.', '2026-08-29 11:22:00', NULL, NULL),
(10, 4, NULL, 'tenant', 'INSTITUTE_ADMIN', 0, 'Also seeing the same on row 47 now. Uploading the file again tonight.', '2026-08-30 19:00:00', NULL, NULL),
(11, 5, NULL, 'tenant', 'INSTITUTE_ADMIN', 0, 'We sent ~12k SMS last week but the gateway panel still shows the pre-send balance. Credits are not being deducted on our account overview.', '2026-08-15 16:30:00', NULL, NULL),
(12, 5, 1, 'staff', 'SAAS_ADMIN', 1, 'The gateway balance was a cached value - the actual deduction happened but the overview was reading a stale snapshot. We have flushed the cache and the correct balance is now displayed.', '2026-08-16 10:00:00', NULL, NULL),
(13, 5, NULL, 'tenant', 'INSTITUTE_ADMIN', 0, 'Confirmed, balance is now accurate. Thank you.', '2026-08-16 11:30:00', NULL, NULL),
(31, 1, 2, 'tenant', 'INSTITUTE_ADMIN', 0, 'ysrgvb', '2026-09-02 16:25:24', '/uploads/support/leads_report_admission.csv-1788346524849-723769383.csv', 'leads_report_admission.csv'),
(32, 4, 1, 'staff', 'SAAS_ADMIN', 1, 'pusher', '2026-09-02 18:42:49', NULL, NULL),
(33, 4, 1, 'staff', 'SAAS_ADMIN', 1, 'pusher', '2026-09-02 18:42:53', NULL, NULL),
(34, 17, 101, 'tenant', 'BRANCH_ADMIN', 0, 'The titration kits in Chemistry Lab B need replacement before next Monday batch exams.', '2026-09-09 18:23:24', NULL, NULL),
(35, 17, 2, 'staff', 'INSTITUTE_ADMIN', 1, 'Approved. Purchase order PO-2026-CHEM has been raised for the Mumbai West center.', '2026-09-09 18:23:24', NULL, NULL),
(36, 17, 101, 'tenant', 'BRANCH_ADMIN', 0, 'Thank you for the quick approval! We will coordinate with the vendor.', '2026-09-09 18:23:24', NULL, NULL),
(37, 18, 2, 'tenant', 'INSTITUTE_ADMIN', 0, '1234567890', '2026-09-22 13:24:40', NULL, NULL),
(38, 18, 1, 'staff', 'SAAS_ADMIN', 1, 'yrcguvhjk', '2026-09-28 12:05:10', NULL, NULL),
(39, 18, 1, 'staff', 'SAAS_ADMIN', 1, 'ghjkl', '2026-09-28 12:05:12', NULL, NULL);

