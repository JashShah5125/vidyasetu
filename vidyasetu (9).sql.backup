(10, 2, 14, '2026-09-20 17:30:00', 'Sent sample study modules on WhatsApp. Parent requested follow-up over weekend after discussing with father.', '2026-09-16 18:00:00', 601),
(11, 2, 15, '2026-09-23 15:00:00', 'Outbound call made to parent Mr. Kirit Mehta. Discussed 8th standard ICSE timetable and weekday batch timings.', '2026-09-14 10:15:00', 601),
(12, 2, 16, '2026-09-18 11:30:00', 'First contact call placed. Parent was in a meeting; requested callback on Friday morning.', '2026-09-14 16:00:00', 603),
(13, 2, 17, '2026-09-12 11:00:00', 'Met parent at TALLENTEX seminar desk. Detailed discussion regarding NEET repeater batch focus modules.', '2026-09-09 11:30:00', 601),
(14, 2, 17, NULL, 'Parent visited Pune Camp centre. Verified marksheets, applied merit discount, and finalized enrollment.', '2026-09-15 12:00:00', 601),
(15, 2, 19, '2026-09-11 15:00:00', 'First round counselling call. Parent enquired about batch bus route from Kothrud area.', '2026-09-10 14:30:00', 603),
(16, 2, 19, '2026-09-14 16:00:00', 'Second follow-up. Parent mentioned that 45 mins travel time is too much for daily classes and they prefer a local tuition.', '2026-09-12 11:00:00', 603),
(17, 2, 19, NULL, 'Final call. Parent confirmed admission in nearby local coaching institute. Marked enquiry as lost.', '2026-09-14 16:45:00', 603),
(18, 2, 20, '2026-09-21 16:30:00', 'In-depth discussion on WhatsApp voice call. Explained physics faculty credentials and regular mock test analytics portal.', '2026-09-15 12:00:00', 601),
(19, 2, 21, '2026-09-23 11:00:00', 'Discussed foundation batch syllabus. Scheduled offline demo lecture for student on Saturday afternoon at Pune Camp.', '2026-09-15 16:00:00', 601),
(20, 2, 22, '2026-09-19 12:00:00', 'Parent discussed ICSE subject options. Decided on Computer Science + Foundation Core bundles. Finalizing installment schedule.', '2026-09-16 11:00:00', 603),
(21, 2, 24, '2026-09-22 17:00:00', 'Introduced NEET batch highlights and previous year AIIMS selections. Emailed complete prospectus and admission form.', '2026-09-16 15:30:00', 603),
(22, 2, 25, '2026-09-21 15:00:00', 'Followed up with parent. Sibling is already enrolled in 10th foundation. Offered existing student sibling concession.', '2026-09-16 17:00:00', 601);

