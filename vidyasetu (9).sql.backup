--

INSERT INTO `student_doubt_replies` (`id`, `doubt_id`, `sender_user_id`, `sender_role`, `message`, `attachments`, `is_read`, `created_at`) VALUES
(9, 3, 228, 'student', 'Sir, in XeF6 why is the geometry considered distorted octahedral instead of regular octahedral? Can you please clarify the stereo-active lone pair position?', '[\"/uploads/doubts/sample_xef6_structure.png\"]', 1, '2026-09-15 11:41:23'),
(10, 4, 230, 'student', 'Sir, in adiabatic reversible expansion, dS_system = 0. But what happens to the entropy of the surroundings? Does it also remain zero?', '[]', 1, '2026-09-15 08:41:23'),
(11, 4, 215, 'teacher', 'Yes, in a reversible adiabatic process, heat exchange q_rev is 0 for both system and surroundings, so delta S_total = delta S_system + delta S_surroundings = 0.', '[]', 1, '2026-09-15 09:41:23'),
(12, 4, 230, 'student', 'Understood sir! And what if the adiabatic expansion is irreversible (free expansion against vacuum)?', '[]', 1, '2026-09-15 12:56:23'),
(13, 5, 244, 'student', 'Sir, for benzaldehyde reacting with concentrated 50% NaOH, why does it undergo Cannizzaro reaction instead of Aldol condensation?', '[\"/uploads/doubts/sample_reaction_mechanism.pdf\"]', 1, '2026-09-15 05:41:23'),
(14, 5, 215, 'teacher', 'Benzaldehyde lacks alpha-hydrogens (no hydrogen attached to the alpha carbon adjacent to -CHO). Aldol condensation fundamentally requires alpha-H for enolate ion generation. Hence, hydride transfer occurs leading to disproportionation (Cannizzaro).', '[]', 1, '2026-09-15 07:41:23'),
(15, 6, 236, 'student', 'Sir, taking -log(10^-8) gives pH 8, which is basic for an acidic HCl solution. How do we account for auto-ionization of water?', '[]', 1, '2026-09-14 13:41:23'),
(16, 6, 215, 'teacher', 'Total [H+] = [H+]_acid + [H+]_water = 10^-8 + x. Since Kw = [H+][OH-] = (10^-8 + x)(x) = 10^-14, solving the quadratic gives [H+] = 1.05 * 10^-7 M, resulting in pH ~ 6.98 (slightly acidic as expected).', '[]', 1, '2026-09-14 17:41:23'),
(17, 6, 236, 'student', 'Thank you so much sir! Perfectly clear now.', '[]', 1, '2026-09-14 19:21:23'),
(18, 7, 238, 'student', 'Sir, why does adding an inert gas at constant pressure shift the equilibrium towards more moles, but at constant volume has no effect?', '[]', 1, '2026-09-14 07:41:23'),
(19, 7, 215, 'teacher', 'At constant volume, the partial pressures of reactants and products remain unchanged because total moles and volume both increase proportionately. At constant pressure, total volume must expand, which dilutes all partial pressures, shifting equilibrium towards more gaseous moles.', '[]', 1, '2026-09-14 12:41:23'),
(20, 7, 238, 'student', 'Wait sir, one more follow-up: what if delta n_g = 0 in the reaction?', '[]', 1, '2026-09-15 13:11:23'),
(21, 8, 246, 'student', 'Sir, could you please explain when d4 metal ions form high spin (t2g^3 eg^1) vs low spin (t2g^4 eg^0) configurations in terms of pairing energy P and delta_o?', '[\"/uploads/doubts/cft_d4_diagram.png\"]', 1, '2026-09-15 13:26:23'),
(22, 7, 215, 'teacher', 'ok good', '[]', 0, '2026-09-15 13:48:58'),
(27, 9, 322, 'student', 'Maam, how do we choose u and v when integrating ∫ x * arctan(x) dx using the ILATE rule?', NULL, 1, '2026-09-21 15:26:58'),
(28, 10, 324, 'student', 'Could you explain why f(x) = x^3 - 3x + k must have at least one root in [-1, 1] if f(-1) and f(1) have opposite signs?', NULL, 1, '2026-09-20 17:26:58'),
(29, 10, 202, 'teacher', 'That follows from the Intermediate Value Theorem because polynomials are continuous everywhere. Check the interval endpoints.', NULL, 1, '2026-09-21 14:26:58'),
(30, 11, 326, 'student', 'How do we find A^-1 if characteristic polynomial is A^2 - 4A + 3I = 0?', NULL, 1, '2026-09-19 17:26:58'),
(31, 11, 202, 'teacher', 'Multiply by A^-1: A - 4I + 3A^-1 = 0 => 3A^-1 = 4I - A => A^-1 = (4I - A)/3.', NULL, 1, '2026-09-20 17:26:58'),
(32, 12, 228, 'student', 'Sir, when a magnet moves towards a closed ring, how do we determine whether the induced current flows clockwise or anticlockwise from the observer point of view?', '[]', 0, '2026-10-05 13:30:51'),
(33, 12, 228, 'student', 'Also sir, what happens if the ring has a cut / open circuit?', '[]', 0, '2026-10-05 13:30:51'),
(34, 13, 228, 'student', 'Sir, how do we integrate elemental rings from apex to base to derive I = 1/2 M R^2 for a hollow cone?', '[]', 0, '2026-10-05 13:31:32'),
(35, 13, 228, 'student', 'Also sir, does this formula change if the axis is passing through the apex parallel to the base?', '[]', 0, '2026-10-05 13:31:32');

-- --------------------------------------------------------

--
-- Table structure for table `student_enrollments`
--

DROP TABLE IF EXISTS `student_enrollments`;
CREATE TABLE IF NOT EXISTS `student_enrollments` (
  `id` int NOT NULL AUTO_INCREMENT,
  `tenant_id` int NOT NULL,
  `branch_id` int NOT NULL,
  `student_id` int NOT NULL,
  `batch_id` int NOT NULL,
  `bundle_id` int DEFAULT NULL,
  `subject_selection_type` enum('bundle','custom') NOT NULL DEFAULT 'bundle',
  `custom_subject_ids` longtext CHARACTER SET utf8mb4 COLLATE utf8mb4_bin,
  `academic_year_id` int NOT NULL,
  `enrolled_date` date NOT NULL,
  `status` varchar(30) NOT NULL DEFAULT 'active',
  `promoted_from_enrollment_id` int DEFAULT NULL,
  `app_access_enabled` tinyint(1) NOT NULL DEFAULT '0',
  `notes` text,
  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `updated_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  `deleted_at` datetime DEFAULT NULL,
  `created_by` int DEFAULT NULL,
  `updated_by` int DEFAULT NULL,
  PRIMARY KEY (`id`),
  UNIQUE KEY `student_id` (`student_id`,`batch_id`,`academic_year_id`),
  KEY `branch_id` (`branch_id`),
  KEY `academic_year_id` (`academic_year_id`),
  KEY `promoted_from_enrollment_id` (`promoted_from_enrollment_id`),
  KEY `idx_enrollments_branch` (`tenant_id`,`branch_id`),
  KEY `idx_enrollments_student` (`student_id`),
  KEY `idx_enrollments_batch` (`batch_id`,`academic_year_id`,`status`),
  KEY `idx_enrollments_bundle` (`bundle_id`)
) ENGINE=InnoDB AUTO_INCREMENT=181 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

